#!/usr/bin/env bash
set -euo pipefail

if [ -n "${GH_TEST_CALLS_FILE:-}" ]; then
  printf '%s\n' "$*" >>"$GH_TEST_CALLS_FILE"
fi

record_overview_timing() {
  local operation="$1"
  if [ -n "${GH_OVERVIEW_TIMING_FILE:-}" ]; then
    printf '%s start\n' "$operation" >>"$GH_OVERVIEW_TIMING_FILE"
    sleep "${GH_OVERVIEW_SLEEP:-0}"
    printf '%s end\n' "$operation" >>"$GH_OVERVIEW_TIMING_FILE"
  fi
}

record_issue_timing() {
  local operation="$1"
  local delay="$2"
  if [ -n "${GH_TEST_ISSUE_TIMING_FILE:-}" ]; then
    printf '%s start\n' "$operation" >>"$GH_TEST_ISSUE_TIMING_FILE"
  fi
  sleep "$delay"
  if [ -n "${GH_TEST_ISSUE_TIMING_FILE:-}" ]; then
    printf '%s end\n' "$operation" >>"$GH_TEST_ISSUE_TIMING_FILE"
  fi
}

if [ "${GH_TEST_NETWORK_FAILURE:-}" = 1 ]; then
  printf 'error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n' >&2
  exit 1
fi

if [ "${GH_TEST_SIGNAL:-}" = 1 ]; then
  kill -TERM "$$"
fi

if [ "${GH_TEST_REPOSITORY_NOT_FOUND:-}" = 1 ]; then
  printf "GraphQL: Could not resolve to a Repository with the name 'riii111/missing'. (repository)\n" >&2
  exit 1
fi

if [ "${GH_TEST_FAILURE:-}" = 1 ]; then
  printf 'simulated gh failure\n' >&2
  exit 23
fi

if [ "${GH_TEST_NONZERO_VALID_JSON:-}" = 1 ]; then
  printf '{"unexpected":"success"}\n'
  printf 'simulated non-zero exit with valid JSON\n' >&2
  exit 23
fi

if [ "${GH_TEST_RATE_LIMIT_RESOURCE:-}" = 1 ]; then
  printf 'failed to read https://api.github.com/rate-limit resource\n' >&2
  exit 1
fi

if [ "${GH_TEST_STDIN_FAILURE:-}" = 1 ]; then
  exec 0<&-
  printf 'simulated stdin failure\n' >&2
  exit 29
fi

if [ "${GH_TEST_INVALID_JSON:-}" = 1 ]; then
  printf 'not json\n'
  exit 0
fi

if [ "$1 $2" = "repo view" ]; then
  if [ "${GH_TEST_REPO_AUTH_FAILURE:-}" = 1 ]; then
    exit 4
  fi
  if [ "${GH_TEST_REPO_METADATA_MISSING:-}" = 1 ]; then
    printf '{}\n'
    exit 0
  fi
  printf '{"nameWithOwner":"riii111/dotfiles"}\n'
  exit 0
fi

if [ "$1 $2" = "pr checks" ]; then
  if [[ " $* " == *" --json bucket "* ]]; then
    if [ "$*" = "pr checks 42 --repo riii111/dotfiles --required --json bucket" ]; then
      bucket_kind=required
    elif [ "$*" = "pr checks 42 --repo riii111/dotfiles --json bucket" ]; then
      bucket_kind=all
    else
      printf 'unexpected overview checks invocation: %s\n' "$*" >&2
      exit 90
    fi

    record_overview_timing "$bucket_kind"
    if [ "$bucket_kind" = required ]; then
      if [ "${GH_OVERVIEW_REQUIRED_FAILURE:-}" = 1 ]; then
        printf 'simulated required checks failure\n' >&2
        exit 23
      fi
      overview_checks="${GH_OVERVIEW_CHECKS:-default}"
    else
      if [ "${GH_OVERVIEW_ALL_FAILURE:-}" = 1 ]; then
        printf 'simulated all checks failure\n' >&2
        exit 24
      fi
      overview_checks="${GH_OVERVIEW_ALL_CHECKS:-default}"
    fi
    case "$overview_checks" in
      empty) printf '[]\n' ;;
      no-required)
        if [ "$bucket_kind" != required ]; then
          printf '[{"bucket":"pass"}]\n'
          exit 0
        fi
        printf "no required checks reported on the 'test' branch\n" >&2
        exit 1
        ;;
      no-checks)
        printf "no checks reported on the 'test' branch\n" >&2
        exit 1
        ;;
      unknown) printf '[{"bucket":"new-state"}]\n' ;;
      default)
        if [ "$bucket_kind" = required ]; then
          printf '[{"bucket":"pass"},{"bucket":"skipping"},{"bucket":"pending"},{"bucket":"fail"},{"bucket":"cancel"}]\n'
        else
          printf '[{"bucket":"pass"},{"bucket":"skipping"},{"bucket":"pending"},{"bucket":"fail"},{"bucket":"cancel"},{"bucket":"pass"},{"bucket":"pending"}]\n'
        fi
        ;;
    esac
    case "${GH_TEST_CHECKS_STATUS:-failure}" in
      pending) exit 8 ;;
      failure) exit 1 ;;
    esac
    exit 0
  fi
  if [ -n "${GH_TEST_ARGS_FILE:-}" ]; then
    printf '%s\n' "$@" >"$GH_TEST_ARGS_FILE"
  fi
  case "${GH_TEST_CHECKS_NEW:-}" in
    success)
      cat <<'JSON'
[{"name":"zeta","state":"PENDING","bucket":"pending","link":"https://example.test/z","workflow":"","startedAt":"0001-01-01T00:00:00Z","completedAt":""},{"name":"alpha","state":"SUCCESS","bucket":"pass","link":"https://example.test/b","workflow":"CI","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:05:00Z"},{"name":"alpha","state":"SUCCESS","bucket":"skipping","link":"https://example.test/a","workflow":"CI","startedAt":"2026-08-11T08:00:00Z","completedAt":"2026-08-11T08:05:00Z"}]
JSON
      if [ "${GH_TEST_CHECKS_STATUS:-pending}" = unexpected ]; then
        exit 23
      fi
      exit 8
      ;;
    nullable)
      cat <<'JSON'
[{"name":"absent","state":"PENDING","bucket":"pending","link":"","workflow":"","startedAt":"0001-01-01T00:00:00Z","completedAt":""},{"name":"present","state":"SUCCESS","bucket":"pass","link":"https://example.test/present","workflow":"CI","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:05:00Z"}]
JSON
      exit 0
      ;;
    missing)
      printf '[{"name":"test","state":"SUCCESS","bucket":"pass","link":"https://example.test/test","workflow":"CI","startedAt":"2026-08-11T10:00:00Z"}]\n'
      exit 0
      ;;
    wrong-type)
      printf '[{"name":"test","state":"SUCCESS","bucket":"pass","link":42,"workflow":"CI","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z"}]\n'
      exit 0
      ;;
    wrong-metadata-type)
      printf '[{"name":"test","state":"SUCCESS","bucket":"pass","link":"https://example.test/test","workflow":42,"startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z"}]\n'
      exit 0
      ;;
    unknown)
      printf '[{"name":"test","state":"SUCCESS","bucket":"mystery","link":"https://example.test/test","workflow":"CI","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z"}]\n'
      exit 0
      ;;
    object)
      printf '{"name":"test"}\n'
      exit 0
      ;;
    authentication)
      printf 'HTTP 401: Requires authentication; run gh auth login\n' >&2
      exit 4
      ;;
    no-required)
      printf "no required checks reported on the 'feature' branch\n" >&2
      exit 1
      ;;
    no-checks)
      printf "no checks reported on the 'feature' branch\n" >&2
      exit 1
      ;;
    missing-pr)
      printf 'GraphQL: Could not resolve to a PullRequest with the number of 999999. (repository.pullRequest)\n' >&2
      exit 1
      ;;
    missing-repository)
      printf "GraphQL: Could not resolve to a Repository with the name 'missing'. (repository)\n" >&2
      exit 1
      ;;
  esac
  printf '[{"name":"ci","state":"SUCCESS","bucket":"pass","link":"https://example.test/ci"}]\n'
  case "${GH_TEST_CHECKS_STATUS:-success}" in
    pending) exit 8 ;;
    failure) exit 1 ;;
  esac
  exit 0
fi

if [ "$1 $2" = "api graphql" ]; then
  payload="$(cat)"
  if jq -e '.variables | has("number")' <<<"$payload" >/dev/null \
    && ! jq -e '.variables.number | type == "number" and . == floor' <<<"$payload" >/dev/null; then
    printf 'GraphQL pull request number must be an integer JSON number\n' >&2
    exit 91
  fi
  if [ "${GH_TEST_GRAPHQL_ERROR:-}" = 1 ]; then
    if [ -n "${GH_TEST_GRAPHQL_ERROR_TYPE:-}" ]; then
      printf '{"errors":[{"type":"%s","message":"simulated GraphQL failure"}]}\n' \
        "$GH_TEST_GRAPHQL_ERROR_TYPE"
    else
      printf '{"errors":[{"message":"simulated GraphQL failure"}]}\n'
    fi
    exit 0
  fi
  if [ "${GH_TEST_MISSING_PR:-}" = 1 ]; then
    printf '{"data":{"repository":{"pullRequest":null}}}\n'
    exit 0
  fi
  if [ "${GH_TEST_THREAD_DETAIL_NODE_ERROR:-}" = 1 ]; then
    printf '{"errors":[{"message":"Could not resolve to a node with the global id of missing"}]}\n'
    exit 0
  fi
  if jq -e '.query | contains("ReviewThreadDetailComments")' <<<"$payload" >/dev/null; then
    if [ "${GH_TEST_THREAD_DETAILS:-}" = 1 ]; then
      comment_a_body='human\n<details data-source=\"bot\">\n<summary>証拠</summary>\n省略\n</details>\nreply'
    else
      comment_a_body='first by id'
    fi
    if [ "${GH_TEST_THREAD_DETAIL_PAGE_FAILURE:-}" = 1 ]; then
      printf 'simulated thread detail pagination failure\n' >&2
      exit 34
    fi
    if [ -n "${GH_THREAD_DETAIL_PAGINATION:-}" ]; then
      cursor="$(jq -r '.variables.cursor' <<<"$payload")"
      case "${GH_THREAD_DETAIL_PAGINATION}" in
        repeat) next_cursor="$cursor" ;;
        cycle)
          case "$cursor" in
            thread-detail-cycle-a) next_cursor=thread-detail-cycle-b ;;
            thread-detail-cycle-b) next_cursor=thread-detail-cycle-a ;;
          esac
          ;;
      esac
      page_info="{\"hasNextPage\":true,\"endCursor\":\"$next_cursor\"}"
      cat <<JSON
{"data":{"node":{"__typename":"PullRequestReviewThread","id":"thread-detail","comments":{"nodes":[],"pageInfo":$page_info}}}}
JSON
      exit 0
    fi
    cat <<JSON
{"data":{"node":{"__typename":"PullRequestReviewThread","id":"thread-detail","comments":{"nodes":[{"id":"comment-a","url":"https://example.test/a","body":"${comment_a_body:-first by id}","author":null,"createdAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-03T00:00:00Z","diffHunk":"@@ a","replyTo":{"id":"comment-b"}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}
JSON
    exit 0
  fi
  if jq -e '.query | contains("ReviewThreadDetail(")' <<<"$payload" >/dev/null; then
    case "${GH_TEST_THREAD_DETAIL:-success}" in
      missing)
        printf '{"data":{"node":null}}\n'
        ;;
      wrong-type)
        printf '{"data":{"node":{"__typename":"Issue"}}}\n'
        ;;
      wrong-id)
        printf '{"data":{"node":{"__typename":"PullRequestReviewThread","id":"other-thread"}}}\n'
        ;;
      wrong-pr)
        cat <<'JSON'
{"data":{"node":{"__typename":"PullRequestReviewThread","id":"thread-detail","isResolved":false,"isOutdated":false,"path":"src/lib.rs","line":42,"originalLine":39,"startLine":null,"diffSide":"RIGHT","pullRequest":{"number":43,"repository":{"nameWithOwner":"riii111/dotfiles"}},"comments":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}
JSON
        ;;
      wrong-repo)
        cat <<'JSON'
{"data":{"node":{"__typename":"PullRequestReviewThread","id":"thread-detail","isResolved":false,"isOutdated":false,"path":"src/lib.rs","line":42,"originalLine":39,"startLine":null,"diffSide":"RIGHT","pullRequest":{"number":42,"repository":{"nameWithOwner":"other/repo"}},"comments":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}
JSON
        ;;
      success)
        if [ "${GH_TEST_THREAD_DETAILS:-}" = 1 ]; then
          comment_z_body='before\n<DETAILS class=\"evidence\">\n<SUMMARY>結論</SUMMARY>\n折り畳み内容\n</DETAILS>\nafter'
          comment_b_body='second by id'
          comment_a_body='human\n<details data-source=\"bot\">\n<summary>証拠</summary>\n省略\n</details>\nreply'
        else
          comment_z_body='later'
          comment_b_body='second by id'
          comment_a_body='first by id'
        fi
        detail_end_cursor=thread-detail-comment-cursor
        case "${GH_THREAD_DETAIL_PAGINATION:-}" in
          repeat) detail_end_cursor=thread-detail-repeat-cursor ;;
          cycle) detail_end_cursor=thread-detail-cycle-a ;;
        esac
        cat <<JSON
{"data":{"node":{"__typename":"PullRequestReviewThread","id":"thread-detail","isResolved":false,"isOutdated":true,"path":"src/lib.rs","line":42,"originalLine":39,"startLine":null,"diffSide":"RIGHT","pullRequest":{"number":42,"repository":{"nameWithOwner":"riii111/dotfiles"}},"comments":{"nodes":[{"id":"comment-z","url":"https://example.test/z","body":"$comment_z_body","author":{"login":"reviewer"},"createdAt":"2026-01-02T00:00:00Z","updatedAt":"2026-01-02T00:00:00Z","diffHunk":"@@ z","replyTo":null},{"id":"comment-b","url":"https://example.test/b","body":"$comment_b_body","author":{"login":"author"},"createdAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z","diffHunk":"@@ b","replyTo":null}],"pageInfo":{"hasNextPage":true,"endCursor":"$detail_end_cursor"}}}}}
JSON
        ;;
    esac
    exit 0
  fi
  if jq -e '.query | contains("ReviewThreadSummaries")' <<<"$payload" >/dev/null; then
    if [ -n "${GH_THREAD_PAGINATION:-}" ]; then
      cursor="$(jq -r '(.variables.cursor // "initial")' <<<"$payload")"
      case "${GH_THREAD_PAGINATION}" in
        repeat)
          page_info='{"hasNextPage":true,"endCursor":"thread-repeat-cursor"}'
          ;;
        cycle)
          case "$cursor" in
            initial) next_cursor=thread-cycle-a ;;
            thread-cycle-a) next_cursor=thread-cycle-b ;;
            thread-cycle-b) next_cursor=thread-cycle-a ;;
          esac
          page_info="{\"hasNextPage\":true,\"endCursor\":\"$next_cursor\"}"
          ;;
        missing) page_info='{"hasNextPage":true}' ;;
        empty) page_info='{"hasNextPage":true,"endCursor":""}' ;;
        wrong-type) page_info='{"hasNextPage":true,"endCursor":42}' ;;
      esac
      cat <<JSON
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[],"pageInfo":$page_info}}}}}
JSON
      exit 0
    fi
    if jq -e '.variables.cursor == "thread-summary-cursor"' <<<"$payload" >/dev/null; then
      if [ "${GH_TEST_THREAD_PAGE_FAILURE:-}" = 1 ]; then
        printf 'dial tcp: lookup api.github.com: no such host\n' >&2
        exit 32
      fi
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"id":"thread-same-a","isResolved":false,"isOutdated":true,"path":null,"line":null,"originalLine":null,"startLine":null,"diffSide":null,"comments":{"nodes":[{"id":"comment-a","createdAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:30:00Z"}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
    else
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"id":"thread-later","isResolved":false,"isOutdated":false,"path":"later.rs","line":30,"originalLine":29,"startLine":28,"diffSide":"RIGHT","comments":{"nodes":[{"id":"comment-later","createdAt":"2026-01-02T00:00:00Z","updatedAt":"2026-01-02T01:00:00Z"}],"pageInfo":{"hasNextPage":false,"endCursor":null}}},{"id":"thread-same-b","isResolved":false,"isOutdated":false,"path":"same.rs","line":12,"originalLine":10,"startLine":null,"diffSide":"LEFT","comments":{"nodes":[{"id":"comment-b1","createdAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:10:00Z"}],"pageInfo":{"hasNextPage":true,"endCursor":"comment-summary-cursor"}}},{"id":"thread-resolved-summary","isResolved":true,"isOutdated":false,"path":"done.rs","line":4,"originalLine":4,"startLine":null,"diffSide":"RIGHT","comments":{"nodes":[{"id":"comment-r1","createdAt":"2025-12-31T00:00:00Z","updatedAt":"2025-12-31T00:10:00Z"}],"pageInfo":{"hasNextPage":true,"endCursor":"resolved-summary-cursor"}}}],"pageInfo":{"hasNextPage":true,"endCursor":"thread-summary-cursor"}}}}}}
JSON
    fi
    exit 0
  fi
  if jq -e '.query | contains("ReviewThreadSummaryComments")' <<<"$payload" >/dev/null; then
    if jq -e '.variables.id == "thread-resolved-summary"' <<<"$payload" >/dev/null; then
      if [ "${GH_FAIL_RESOLVED_COMMENTS:-}" = 1 ]; then
        printf 'resolved summary comments should not be fetched\n' >&2
        exit 88
      fi
      cat <<'JSON'
{"data":{"node":{"comments":{"nodes":[{"id":"comment-r2","createdAt":"2025-12-31T01:00:00Z","updatedAt":"2025-12-31T02:00:00Z"}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}
JSON
      exit 0
    fi
    if [ "${GH_TEST_COMMENT_PAGE_FAILURE:-}" = 1 ]; then
      printf 'simulated comment pagination failure\n' >&2
      exit 33
    fi
    cat <<'JSON'
{"data":{"node":{"comments":{"nodes":[{"id":"comment-b2","createdAt":"2026-01-01T01:00:00Z","updatedAt":"2026-01-03T00:00:00Z"}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}
JSON
    exit 0
  fi
  if jq -e '.query | contains("reviewDecision")' <<<"$payload" >/dev/null; then
    if [ "${GH_OVERVIEW_GRAPHQL_FAILURE:-}" = 1 ]; then
      printf 'simulated GraphQL overview failure\n' >&2
      exit 25
    fi
    record_overview_timing graphql
    if [ -n "${GH_OVERVIEW_TIMING_FILE:-}" ]; then
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"title":"Add pull request title","url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[{"isResolved":false}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
      exit 0
    fi
    if ! jq -e '.query | contains("title") and ((contains("body") or contains("comments") or contains("reviews")) | not)' <<<"$payload" >/dev/null; then
      printf 'overview query requested content fields\n' >&2
      exit 89
    fi
    if [ "${GH_OVERVIEW_TITLE:-}" = missing ]; then
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
      exit 0
    fi
    if [ "${GH_OVERVIEW_TITLE:-}" = invalid ]; then
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"title":42,"url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
      exit 0
    fi
    if [ "${GH_OVERVIEW_NULL_FIELDS:-}" = 1 ]; then
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"title":"Add pull request title","url":"https://github.com/riii111/dotfiles/pull/42","state":null,"isDraft":null,"headRefOid":null,"baseRefOid":null,"reviewDecision":null,"mergeStateStatus":null,"reviewThreads":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
      exit 0
    fi
    if [ -n "${GH_OVERVIEW_PAGINATION:-}" ]; then
      cursor="$(jq -r '(.variables.cursor // "initial")' <<<"$payload")"
      case "${GH_OVERVIEW_PAGINATION}" in
        repeat) page_info='{"hasNextPage":true,"endCursor":"overview-repeat-cursor"}' ;;
        cycle)
          case "$cursor" in
            initial) next_cursor=overview-cycle-a ;;
            overview-cycle-a) next_cursor=overview-cycle-b ;;
            overview-cycle-b) next_cursor=overview-cycle-a ;;
          esac
          page_info="{\"hasNextPage\":true,\"endCursor\":\"$next_cursor\"}"
          ;;
        missing) page_info='{"hasNextPage":true}' ;;
        empty) page_info='{"hasNextPage":true,"endCursor":""}' ;;
        wrong-type) page_info='{"hasNextPage":true,"endCursor":42}' ;;
      esac
      cat <<JSON
{"data":{"repository":{"pullRequest":{"number":42,"title":"Add pull request title","url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[],"pageInfo":$page_info}}}}}
JSON
      exit 0
    fi
    if jq -e '.variables.cursor == "overview-cursor"' <<<"$payload" >/dev/null; then
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"title":"Add pull request title","url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[{"isResolved":false}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}
JSON
    else
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"number":42,"title":"Add pull request title","url":"https://github.com/riii111/dotfiles/pull/42","state":"OPEN","isDraft":false,"headRefOid":"head","baseRefOid":"base","reviewDecision":"APPROVED","mergeStateStatus":"CLEAN","reviewThreads":{"nodes":[{"isResolved":false},{"isResolved":true}],"pageInfo":{"hasNextPage":true,"endCursor":"overview-cursor"}}}}}}
JSON
    fi
    exit 0
  fi
fi

if [ "$1" = api ] && [[ "$*" == *pulls/42/reviews* ]]; then
  if [ "$*" != 'api --method GET --paginate --slurp repos/riii111/dotfiles/pulls/42/reviews?per_page=100' ]; then
    printf 'unexpected reviews invocation: %s\n' "$*" >&2
    exit 90
  fi
  case "${GH_TEST_REVIEWS:-success}" in
    empty)
      printf '[[]]\n'
      ;;
    invalid-page)
      printf '[[{"node_id":"review-a"}],{}]\n'
      ;;
    invalid-field)
      printf '[[{"node_id":"review-a","user":{"login":"alice"},"state":"APPROVED","body":null,"submitted_at":"2026-01-01T00:00:00Z","commit_id":"oid-a"}]]\n'
      ;;
    missing-field)
      printf '[[{"node_id":"review-a","user":{"login":"alice"},"state":"APPROVED","body":"approved","submitted_at":"2026-01-01T00:00:00Z"}]]\n'
      ;;
    page-failure)
      printf '[[{"node_id":"partial"}]]\n'
      printf 'dial tcp: lookup api.github.com: no such host\n' >&2
      exit 32
      ;;
    success)
      cat <<'JSON'
[[{"node_id":"review-z","user":{"login":"zoe"},"state":"COMMENTED","body":"comment","submitted_at":"2026-01-02T00:00:00Z","commit_id":"oid-z"},{"node_id":"review-b","user":{"login":"bob"},"state":"APPROVED","body":"approved","submitted_at":"2026-01-01T00:00:00Z","commit_id":"oid-b"},{"node_id":"review-null-a","user":{"login":"pending"},"state":"PENDING","body":"pending","submitted_at":null,"commit_id":null},{"node_id":"review-null","user":null,"state":"DISMISSED","body":"","submitted_at":null,"commit_id":null}],[{"node_id":"review-a","user":{"login":"alice"},"state":"CHANGES_REQUESTED","body":"change","submitted_at":"2026-01-01T00:00:00Z","commit_id":"oid-a"},{"node_id":"review-unknown","user":{"login":"future"},"state":"FUTURE_STATE","body":"future","submitted_at":"2025-12-31T00:00:00Z","commit_id":"oid-future"}]]
JSON
      ;;
  esac
  exit 0
fi

if [ "$*" = "api --method GET --paginate --slurp repos/riii111/dotfiles/issues/42/comments?per_page=100" ] \
  && { [ -n "${GH_PR_COMMENTS:-}" ] || [ -n "${GH_PR_COMMENTS_FAILURE:-}" ]; }; then
  if [ "${GH_PR_COMMENTS_FAILURE:-}" = 1 ]; then
    printf '[[{"node_id":"partial"}]]\n'
    printf 'dial tcp: lookup api.github.com: no such host\n' >&2
    exit 31
  fi
  case "${GH_PR_COMMENTS:-success}" in
    empty)
      printf '[[]]\n'
      ;;
    invalid-page)
      printf '[{"node_id":"not-a-page"}]\n'
      ;;
    invalid-item)
      printf '[[42]]\n'
      ;;
    missing-field)
      printf '[[{"node_id":"IC_missing","html_url":"https://example.test/missing","user":{"login":"author"},"created_at":"2026-01-01T00:00:00Z","updated_at":"2026-01-01T00:00:00Z"}]]\n'
