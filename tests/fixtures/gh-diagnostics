#!/usr/bin/env bash
set -euo pipefail

if [ -n "${GH_DIAGNOSTICS_CALLS:-}" ]; then
  printf '%s\n' "$*" >>"$GH_DIAGNOSTICS_CALLS"
fi

if [ "$1 $2" = "api graphql" ]; then
  payload="$(cat)"
  test -n "$payload"
  case "${GH_DIAGNOSTICS_MODE:-normal}" in
    no-failures)
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"commits":{"nodes":[{"commit":{"oid":"head","statusCheckRollup":{"contexts":{"nodes":[{"__typename":"CheckRun","databaseId":103,"name":"pass","isRequired":true,"status":"COMPLETED","conclusion":"SUCCESS","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:01:00Z","detailsUrl":"https://example.test/pass","checkSuite":{"workflowRun":{"event":"PUSH","workflow":{"name":"CI"}}}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}]}}}}}
JSON
      ;;
    status-collision)
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"commits":{"nodes":[{"commit":{"oid":"head","statusCheckRollup":{"contexts":{"nodes":[{"__typename":"StatusContext","context":"shared","isRequired":true,"state":"FAILURE","targetUrl":"https://ci.example.test/shared","description":"status"},{"__typename":"CheckRun","databaseId":102,"name":"shared","isRequired":true,"status":"COMPLETED","conclusion":"FAILURE","startedAt":"0001-01-01T00:00:00Z","completedAt":"0001-01-01T00:00:00Z","detailsUrl":"https://ci.example.test/shared","checkSuite":{"workflowRun":{"event":"PUSH","workflow":{"name":"CI"}}}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}]}}}}}
JSON
      ;;
    check-run-collision)
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"commits":{"nodes":[{"commit":{"oid":"head","statusCheckRollup":{"contexts":{"nodes":[{"__typename":"CheckRun","databaseId":102,"name":"duplicate","isRequired":true,"status":"COMPLETED","conclusion":"FAILURE","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z","detailsUrl":"https://ci.example.test/duplicate","checkSuite":{"workflowRun":{"event":"PUSH","workflow":{"name":"CI"}}}},{"__typename":"CheckRun","databaseId":103,"name":"duplicate","isRequired":true,"status":"COMPLETED","conclusion":"FAILURE","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z","detailsUrl":"https://ci.example.test/duplicate","checkSuite":{"workflowRun":{"event":"PULL_REQUEST","workflow":{"name":"CI"}}}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}]}}}}}
JSON
      ;;
    *)
      cat <<'JSON'
{"data":{"repository":{"pullRequest":{"commits":{"nodes":[{"commit":{"oid":"head","statusCheckRollup":{"contexts":{"nodes":[{"__typename":"CheckRun","databaseId":100,"name":"actions-failure","isRequired":true,"status":"COMPLETED","conclusion":"FAILURE","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z","detailsUrl":"https://github.com/owner/repo/actions/runs/10/job/20?pr=42","checkSuite":{"workflowRun":{"event":"PUSH","workflow":{"name":"CI"}}}},{"__typename":"CheckRun","databaseId":101,"name":"external-cancel","isRequired":true,"status":"COMPLETED","conclusion":"CANCELLED","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:05:00Z","detailsUrl":"https://ci.example.test/build/7","checkSuite":{"workflowRun":null}},{"__typename":"CheckRun","databaseId":103,"name":"pass","isRequired":true,"status":"COMPLETED","conclusion":"SUCCESS","startedAt":"2026-08-11T08:00:00Z","completedAt":"2026-08-11T08:05:00Z","detailsUrl":"https://example.test/pass","checkSuite":{"workflowRun":{"event":"PUSH","workflow":{"name":"CI"}}}}],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}]}}}}}
JSON
      ;;
  esac
  exit 0
fi

if [ "$1 $2" = "pr checks" ]; then
  case "${GH_DIAGNOSTICS_MODE:-normal}" in
    no-failures)
      cat <<'JSON'
[{"name":"pass","state":"SUCCESS","bucket":"pass","link":"https://example.test/pass","workflow":"CI","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:01:00Z"}]
JSON
      ;;
    status-collision)
      cat <<'JSON'
[{"name":"shared","state":"FAILURE","bucket":"fail","link":"https://ci.example.test/shared","workflow":"external","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z"}]
JSON
      ;;
    *)
      cat <<'JSON'
[{"name":"actions-failure","state":"FAILURE","bucket":"fail","link":"https://github.com/owner/repo/actions/runs/10/job/20?pr=42","workflow":"CI","startedAt":"2026-08-11T10:00:00Z","completedAt":"2026-08-11T10:05:00Z"},{"name":"external-cancel","state":"CANCELLED","bucket":"cancel","link":"https://ci.example.test/build/7","workflow":"external","startedAt":"2026-08-11T09:00:00Z","completedAt":"2026-08-11T09:05:00Z"},{"name":"pass","state":"SUCCESS","bucket":"pass","link":"https://example.test/pass","workflow":"CI","startedAt":"2026-08-11T08:00:00Z","completedAt":"2026-08-11T08:05:00Z"}]
JSON
      ;;
  esac
  exit 0
fi

if [ "$1 $2" = "pr view" ]; then
  printf '{"headRefOid":"head"}\n'
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *commits/head/check-runs* ]]; then
  if [ "${GH_DIAGNOSTICS_MODE:-normal}" = status-collision ]; then
    cat <<'JSON'
[{"total_count":1,"check_runs":[{"id":102,"name":"shared","details_url":"https://ci.example.test/shared","status":"completed","conclusion":"failure","started_at":"0001-01-01T00:00:00Z","completed_at":"0001-01-01T00:00:00Z"}]}]
JSON
    exit 0
  fi
  cat <<'JSON'
[{"total_count":2,"check_runs":[{"id":100,"name":"actions-failure","details_url":"https://github.com/owner/repo/actions/runs/10/job/20?pr=42","status":"completed","conclusion":"failure","started_at":"2026-08-11T10:00:00Z","completed_at":"2026-08-11T10:05:00Z"},{"id":101,"name":"external-cancel","details_url":"https://ci.example.test/build/7","status":"completed","conclusion":"cancelled","started_at":"2026-08-11T09:00:00Z","completed_at":"2026-08-11T09:05:00Z"}]}]
JSON
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *check-runs/100/annotations* ]]; then
  if [ "${GH_DIAGNOSTICS_MODE:-normal}" = annotation-failure ]; then
    printf '[[{"path":"partial.rs"}]]\n'
    printf 'simulated annotation pagination failure\n' >&2
    exit 31
  fi
  cat <<'JSON'
[[{"path":"z.rs","start_line":9,"end_line":10,"annotation_level":"failure","title":"zeta","message":"later"}],[{"path":"a.rs","start_line":2,"end_line":2,"annotation_level":"failure","title":"beta","message":"same"},{"path":"a.rs","start_line":1,"end_line":1,"annotation_level":"warning","title":null,"message":"first"}]]
JSON
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *check-runs/101/annotations* ]]; then
  printf '[[]]\n'
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *check-runs/102/annotations* ]]; then
  if [ "${GH_DIAGNOSTICS_MODE:-normal}" = check-run-collision ]; then
    printf '[[{"path":"first.rs","start_line":1,"end_line":1,"annotation_level":"failure","title":null,"message":"first"}]]\n'
  else
    printf '[[{"path":"collision.rs","start_line":1,"end_line":1,"annotation_level":"failure","title":null,"message":"check run"}]]\n'
  fi
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *check-runs/103/annotations* ]]; then
  printf '[[{"path":"second.rs","start_line":2,"end_line":2,"annotation_level":"failure","title":null,"message":"second"}]]\n'
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *actions/jobs/20 ]] && [[ "$*" != *actions/jobs/20/logs* ]]; then
  if [ "${GH_DIAGNOSTICS_MODE:-normal}" = metadata-failure ]; then
    printf 'simulated job metadata failure\n' >&2
    exit 43
  fi
  if [ "${GH_DIAGNOSTICS_MODE:-normal}" = job-mismatch ]; then
    printf '{"id":20,"check_run_url":"https://api.github.com/repos/owner/repo/check-runs/999","head_sha":"head"}\n'
  else
    printf '{"id":20,"check_run_url":"https://api.github.com/repos/owner/repo/check-runs/100","head_sha":"head"}\n'
  fi
  exit 0
fi

if [ "$1" = api ] && [[ "$*" == *actions/jobs/20/logs* ]]; then
  case "${GH_DIAGNOSTICS_MODE:-normal}" in
    log-failure)
      printf 'simulated log failure\n' >&2
      exit 42
      ;;
    timeout)
      sleep 30 &
      sleeper=$!
      if [ -n "${GH_DIAGNOSTICS_PID_FILE:-}" ]; then
        printf '%s\n' "$sleeper" >"$GH_DIAGNOSTICS_PID_FILE"
      fi
      wait "$sleeper"
      ;;
    progress)
      sleep 16
      ;;
  esac
  for line in $(seq 1 205); do
    printf 'line-%03d\n' "$line"
  done
  head -c 70000 /dev/zero | tr '\0' x
  printf 'tail\n'
  exit 0
fi

printf 'unexpected gh invocation: %s\n' "$*" >&2
exit 99
